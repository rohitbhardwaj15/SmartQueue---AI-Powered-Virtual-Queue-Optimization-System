PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartqueue
CLIENT_ORIGIN=http://localhost:3000

# Admin auth. Required in any real deployment - if unset, admin routes are
# now disabled (403) by default rather than open. Set ALLOW_INSECURE_ADMIN=true
# only for local development if you want to skip setting a key.
ADMIN_API_KEY=change-this-admin-key
ALLOW_INSECURE_ADMIN=false

# Rate limiting (all optional, sensible defaults are used if omitted)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JOIN_RATE_LIMIT_WINDOW_MS=60000
JOIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=20

# Optional: share rate-limit counters across multiple instances/serverless
# cold starts via Redis. Without this, each process/instance tracks its
# own quota independently - fine for a single Render instance, not fine
# for horizontal scaling or the Vercel serverless deployment.
# REDIS_URL=redis://localhost:6379

# Optional: number of reverse-proxy hops in front of this server, used so
# express-rate-limit sees the real client IP instead of the proxy's.
# Defaults to 1, which matches a single Render/Vercel edge hop. Only raise
# this if you know there are more hops - trusting more than actually exist
# lets clients spoof their IP via X-Forwarded-For.
# TRUST_PROXY=1
